{
  "name": "mbg-observable-core-workspace-rc4-d-final-acceptance",
  "private": true,
  "version": "1.0.0-rc4-d-final-acceptance",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix core ci && npm --prefix frontend ci",
    "check:core": "npm --prefix core run typecheck && npm --prefix core test",
    "build:frontend": "npm --prefix frontend run build",
    "dev:core": "npm --prefix core run dev:readonly-api",
    "dev:frontend": "npm --prefix frontend run dev",
    "verify:readonly-surface": "npm --prefix core run verify:readonly-surface",
    "verify:runtime-snapshot": "npm --prefix core run test:runtime-snapshot",
    "verify:runtime-readmodel": "npm --prefix core run verify:runtime-readmodel",
    "verify:runtime-api": "npm --prefix core run verify:runtime-api",
    "verify:rc3": "node scripts/verify-rc3.mjs",
    "verify:runtime-source": "npm --prefix core run verify:runtime-source",
    "verify:self-truth": "npm --prefix core run verify:self-truth",
    "verify:rc3_5": "node scripts/verify-rc3-5.mjs",
    "verify:semantic-hardening": "node scripts/verify-semantic-hardening.mjs",
    "verify:all": "npm run check:core && npm run verify:rc3_5 && npm run verify:semantic-hardening && npm run build:frontend",
    "verify:rc4-live-readonly": "npm --prefix core run verify:rc4-live-readonly",
    "verify:core-overview": "npm --prefix core run verify:core-overview",
    "verify:rc4": "node scripts/verify-rc4.mjs",
    "verify:rc4-b-frontend-panels": "node scripts/verify-rc4-b-frontend-panels.mjs",
    "verify:rc4-b": "npm run verify:rc4 && npm run verify:rc4-b-frontend-panels && npm run build:frontend",
    "verify:frontend-layout": "node scripts/verify-frontend-layout.mjs",
    "verify:rc4-c": "npm run verify:rc4-b && npm run verify:frontend-layout && npm run verify:rc4-c-ui-hotfix && npm run build:frontend",
    "verify:frontend-language": "node scripts/verify-frontend-language.mjs",
    "verify:layout-normalization": "node scripts/verify-layout-normalization.mjs",
    "verify:operator-ui": "node scripts/verify-operator-ui.mjs",
    "verify:rc4-c-ui-hotfix": "npm run verify:frontend-language && npm run verify:layout-normalization && npm run verify:operator-ui && npm run verify:frontend-layout && npm run build:frontend",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:final-acceptance": "node scripts/verify-final-acceptance.mjs",
    "verify:semantic-labels": "node scripts/verify-semantic-labels.mjs",
    "verify:launchers": "node scripts/verify-launchers.mjs",
    "verify:rc4-d": "node scripts/verify-rc4-d.mjs",
    "verify:ui-machine-guardrail": "node scripts/verify-ui-machine-guardrail.mjs"
  }
