diff -ruN '--exclude=node_modules' '--exclude=data' '--exclude=package-lock.json' /mnt/data/wave10a_work/mbg-core-v0.1-alpha8/mbg-core-v0.1-alpha8/tests/scenarios/wave10-observable-machine-audit.ts /mnt/data/wave10a_work/repo/tests/scenarios/wave10-observable-machine-audit.ts
--- /mnt/data/wave10a_work/mbg-core-v0.1-alpha8/mbg-core-v0.1-alpha8/tests/scenarios/wave10-observable-machine-audit.ts	1970-01-01 00:00:00.000000000 +0000
