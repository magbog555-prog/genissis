+  const report = getReport("replay mismatch report");
+  assertTrustState(report, "COMPROMISED", "replay mismatch");
+  assert.equal(report.tradingAllowed, false);
+  assertHasReason(report, "replay_mismatch", "replay mismatch");
+});
