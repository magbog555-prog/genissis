+- current: `core/runtime/event-index.ts`
+- future: `core/quarantine/quarantine-store.ts`
+- future: `core/recovery/recovery-planner.ts`
+- future: `core/permissions/permission-ledger.ts`
+- tests: `tests/scenarios/*`
+
